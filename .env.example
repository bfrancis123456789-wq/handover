# Copy to .env.local and fill in from Supabase > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public VAPID key for push notifications (the private key goes in the send-push function's secrets)
VITE_VAPID_PUBLIC_KEY=
# Error monitoring (optional). Leave empty to turn it off.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
# The Anthropic key is NOT set here. It lives in Supabase as a function secret:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
